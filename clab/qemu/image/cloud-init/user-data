#cloud-config

users:
  - name: openperouter
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # password: openperouter (hashed)
    passwd: $6$rounds=4096$saltsalt$oBm8JQR0cXK0r3.ZxfI9fXHxBBr7JHQO.RGUfNn7qXKLlSLCKnV5h5kWoYk5C6NOVwx3hW6NFGHH7RLI0XR./
    ssh_authorized_keys: []

ssh_pwauth: true

package_update: true
package_upgrade: false

packages:
  - iproute
  - pciutils
  - numactl
  - numactl-libs
  - dpdk
  - dpdk-tools
  - kernel-modules-extra
  - jq
  - curl
  - tar

write_files:
  - path: /etc/udev/rules.d/70-persistent-net.rules
    content: |
      # Rename igb NICs to match the host-side bridge names.
      # MACs are assigned by launch.sh in NIC order.
      SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="52:54:00:ab:cd:01", NAME="toswitch1"
      SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="52:54:00:ab:cd:02", NAME="toswitch2"
      SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="52:54:00:ab:cd:03", NAME="toleafkind1"
      SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="52:54:00:ab:cd:04", NAME="toleafkind2"

  - path: /etc/modules-load.d/vfio.conf
    content: |
      vfio-pci

  #- path: /etc/sysctl.d/99-hugepages.conf
  #  content: |
  #    vm.nr_hugepages=1024

runcmd:
  - grubby --update-kernel=DEFAULT --args="intel_iommu=on iommu=pt hugepagesz=1G hugepages=2 default_hugepagesz=2M console=ttyS0,115200n8"
  - modprobe vfio-pci
  # Install k3s (but don't start it — setup.sh starts it after image import)
  - "curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC='--disable=traefik' K3S_KUBECONFIG_MODE=644 INSTALL_K3S_SKIP_START=true sh -"
  # Signal that cloud-init is done
  - touch /var/lib/cloud/instance/boot-finished-signal

final_message: "cloud-init completed in $UPTIME seconds"
